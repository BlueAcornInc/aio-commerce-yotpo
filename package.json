    "@adobe/aio-commerce-lib-app": "^1.11.0",
    "@adobe/aio-commerce-lib-config": "^1.8.0",
    "@adobe/aio-sdk": "^6.0.0"
  },
  "devDependencies": {
    "@adobe/eslint-config-aio-lib-config": "^4.0.0",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
